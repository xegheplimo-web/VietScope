# Search Hub — Environment Configuration
# Copy this to .env and adjust as needed

# --- LLM for RAG synthesis (optional) ---
# Use OpenAI, Groq, Ollama, or any OpenAI-compatible endpoint
# Leave empty to use extractive summary (no LLM needed)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional per-role model overrides (empty = use LLM_MODEL)
#LLM_PLANNER_MODEL=
#LLM_SYNTH_MODEL=
#LLM_VERIFY_MODEL=
#LLM_EXTRACT_MODEL=
EMBEDDING_MODEL=

# --- Business geo storage ---
# Uses the canonical hub-postgres DSN (HUB_DATABASE_URL below). Empty DSN
# disables the PostGIS business store (degrades to web-extract).

# --- Semantic embedding rerank (optional, OpenAI-compatible /embeddings) ---
# Leave EMBEDDING_MODEL empty to disable semantic reranking
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Pipeline tuning ---
MAX_RESULTS=10
SCRAPE_TOP_N=5
SCRAPE_TIMEOUT=60
CHUNK_SIZE=800
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_SOURCE=3

# --- Search Router server ---
# Comma-separated allowed CORS origins for the router's CORSMiddleware.
# Uncomment to override; the default covers local dev frontends on both
# localhost and 127.0.0.1 (Next.js :3000, Vite :5173).
#CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- GitHub (optional, for code search) ---
GITHUB_TOKEN=

# --- Exa (premium semantic search, optional, deep_research only) ---
# Leave empty to disable the Exa provider
EXA_API_KEY=

# --- Public API auth (P10/P11) ---
# Bearer API-key auth on /v1/* POST endpoints. Only sha256 hashes are stored
# in hub-postgres. Manage keys with: python search-router/manage_keys.py
API_AUTH_ENABLED=false
# Bootstrap admin key — read once at startup, then hashed + stored with
# scopes {*}, rpm 10000, unlimited quota. Generate one with:
#   python -c "import secrets; print('dsa_live_' + secrets.token_urlsafe(24))"
HUB_ADMIN_KEY=
# Scoped key for the MCP adapter (adapters/mcp_server.py, scripts/start-mcp-*).
# Least privilege — never use HUB_ADMIN_KEY on this path. Create one with:
#   python search-router/manage_keys.py create --tenant hermes --name hermes-mcp --scopes "search:read,read:use"
SEARCH_HUB_ROUTER_KEY=
# OpenAI-compatible gateway (P1) — GET /v1/models + POST /v1/chat/completions.
# Comma-separated model ids advertised to OpenAI-compatible clients.
OPENAI_MODELS=duyai-search
# Request deadline (seconds) for /v1/chat/completions, stream and non-stream.
OPENAI_TIMEOUT_S=300
# hub-postgres DSN (api_keys / tenants / query_logs / usage_daily).
# In compose the default targets the hub-postgres service. From the host
# (manage_keys.py) the default is 127.0.0.1:${HUB_PG_PORT:-5433}.
HUB_DATABASE_URL=
HUB_PG_PASSWORD=searchhub
HUB_PG_PORT=5433

# SearXNG server secret — overrides the placeholder secret_key committed in
# deploy/searxng/settings.yml (the searxng image honors SEARXNG_SECRET).
# Generate a fresh one: openssl rand -hex 32
SEARXNG_SECRET=

# --- MinIO raw snapshot store (Phase 1) ---
# S3-compatible store for immutable raw page snapshots
# (document_snapshots.storage_key). Internal-only ports (loopback).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_RAW=sh-raw-snapshots
# search-router reads these; compose default already targets the minio
# service. From host tools use http://127.0.0.1:9000.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Extraction engine (Phase 3) — Trafilatura main-text extraction + index
EXTRACTION_ENABLED=true
EXTRACTION_MIN_CHARS=100
EXTRACTION_MIN_QUALITY=0.30

# --- Hybrid federated retrieval (P11) ---
# Extra candidate lane in /v1/search mode pipelines: OpenSearch BM25 +
# Qdrant dense (web_passages_v1) fused with RRF, merged into the candidate
# pool before reranking. Requires OPENSEARCH_ENABLED=true (compose default)
# and, for the dense lane, QDRANT_DENSE_ENABLED=true.
HYBRID_RETRIEVAL_ENABLED=true
HYBRID_TOP_K=60
HYBRID_RRF_K=60
HYBRID_FUSED_TOP=40
QDRANT_DENSE_ENABLED=false
