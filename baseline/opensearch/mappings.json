            "tokenizer": "standard",
            "type": "custom"
          },
          "vn_text": {
            "filter": [
              "lowercase",
              "vn_stop"
            ],
            "tokenizer": "standard",
            "type": "custom"
          }
        },
        "filter": {
          "vn_stop": {
            "stopwords": [
              "l\u00e0",
              "c\u1ee7a",
              "v\u00e0",
              "c\u00f3",
              "\u0111\u01b0\u1ee3c",
              "cho",
              "v\u1ec1",
              "t\u1eeb",
              "\u0111\u1ebfn",
              "t\u1ea1i",
              "tr\u00ean",
              "d\u01b0\u1edbi",
              "the",
              "is",
              "a",
              "an",
              "and",
              "or",
              "of",
              "to",
              "in",
              "on",
              "at"
            ],
            "type": "stop"
          }
        },
        "normalizer": {
          "vn_lower": {
            "filter": [
              "lowercase",
              "asciifolding"
            ],
            "type": "custom"
          }
        },
        "tokenizer": {
          "vn_edge": {
            "max_gram": 15,
            "min_gram": 2,
            "token_chars": [
              "letter",
              "digit"
            ],
            "type": "edge_ngram"
          }
        }
      },
      "index": {
        "max_result_window": 10000,
        "number_of_replicas": 0,
        "number_of_shards": 1,
        "refresh_interval": "5s"
      }
    }
  },
