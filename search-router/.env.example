# ===== Search Hub Configuration =====

# --- SearXNG ---
SEARXNG_URL=http://localhost:8080

# --- Firecrawl ---
FIRECRAWL_URL=http://localhost:3002
FIRECRAWL_API_KEY=

# --- LLM for RAG synthesis (OpenAI-compatible) ---
# Works with: OpenAI, Groq, Ollama, any OpenAI-compatible endpoint
# Leave empty to use extractive summary (no LLM needed)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional per-role model overrides (empty = use LLM_MODEL)
#LLM_PLANNER_MODEL=
#LLM_SYNTH_MODEL=
#LLM_VERIFY_MODEL=
#LLM_EXTRACT_MODEL=
EMBEDDING_MODEL=

# --- Business geo storage ---
# Uses the canonical hub-postgres DSN (HUB_DATABASE_URL, see repo-root .env).
# Empty DSN disables the PostGIS business store (degrades to web-extract).

# --- MinIO raw snapshot store (Phase 1) ---
# Empty endpoint disables the object store (/v1/health omits "minio").
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_RAW=sh-raw-snapshots

# Extraction engine (Phase 3)
EXTRACTION_ENABLED=true
EXTRACTION_MIN_CHARS=100
EXTRACTION_MIN_QUALITY=0.30

# --- Semantic embedding rerank (optional, OpenAI-compatible /embeddings) ---
# Leave EMBEDDING_MODEL empty to disable semantic reranking
# (keyword-only fallback keeps current behavior)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Pipeline defaults ---
MAX_RESULTS=10
SCRAPE_TOP_N=5
SCRAPE_TIMEOUT=60
CHUNK_SIZE=800
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_SOURCE=3

# --- Server ---
HOST=0.0.0.0
PORT=8888
# Comma-separated allowed CORS origins (defaults cover local dev frontends
# on both localhost and 127.0.0.1)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- GitHub code search ---
GITHUB_TOKEN=

# --- Exa (premium semantic search, optional, deep_research only) ---
# Leave empty to disable the Exa provider
EXA_API_KEY=

# --- Advanced Settings v2 ---
REDIS_URL=redis://localhost:6379
# P5 answer cache on the research lane (exact + embedding-similarity layers)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIM_THRESHOLD=0.94
POSTGRES_URL=postgresql://postgres:password@localhost:5432/search
INFERENCE_GATEWAY=
DEFAULT_MODE=normal

# Budget defaults for each mode
BUDGET_FAST_MAX_QUERIES=2
BUDGET_FAST_MAX_FETCHES=3
BUDGET_FAST_MAX_FOLLOWUPS=0

BUDGET_NORMAL_MAX_QUERIES=5
BUDGET_NORMAL_MAX_FETCHES=8
BUDGET_NORMAL_MAX_FOLLOWUPS=1

BUDGET_DEEP_MAX_QUERIES=12
BUDGET_DEEP_MAX_FETCHES=20
BUDGET_DEEP_MAX_FOLLOWUPS=3

# Provider enable/disable flags
PROVIDER_SEARXNG_ENABLED=true
PROVIDER_FIRECRAWL_ENABLED=true
PROVIDER_GITHUB_ENABLED=true

# Source Federation Layer (Phase 2)
# Optional JSON overlay for PROVIDER_SPECS:
#   {"providers": {"ddgs": {"enabled": false, "priority": 0.5},
#                  "new_rss": {"source_types": ["news"], "enabled": true}}}
HUB_PROVIDERS_CONFIG=
# Any provider can be toggled without code: PROVIDER_<NAME>_ENABLED=true|false
PROVIDER_DDGS_ENABLED=true
PROVIDER_EXA_ENABLED=true
PROVIDER_ARXIV_ENABLED=true
PROVIDER_HN_ENABLED=true
# Adaptive fan-out caps (external providers per query; internal index exempt)
PROVIDER_FANOUT_MAX_PROVIDERS=6
PROVIDER_FANOUT_MAX_PROVIDERS_FAST=3
# --- Observability ---
# Structured JSON logs go to stdout by default (JSON_LOGS=true).
# To also ship them to Loki (the compose `loki` service), opt in:
#LOKI_URL=http://loki:3100
#JSON_LOGS_LOKI=true
# OTEL traces are opt-in too: OTEL_ENABLED=true, OTEL_EXPORTER_OTLP_ENDPOINT=...

# Provider health scoring / circuit breaker
PROVIDER_HEALTH_WINDOW=64
PROVIDER_HEALTH_MAX_WINDOW_AGE_S=1800
PROVIDER_HEALTH_COOLDOWN_S=300
PROVIDER_HEALTH_MAX_COOLDOWN_S=1800
PROVIDER_HEALTH_MAX_CONSECUTIVE_FAILURES=3
PROVIDER_HEALTH_OPEN_SCORE=0.30
PROVIDER_HEALTH_CAPTCHA_TRIP_RATE=0.5
