FROM python:3.12-slim

WORKDIR /app

# Install system deps for sentence-transformers + torch
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libcurl4-openssl-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy the shared requirements first (cached layer)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the reranker service module
COPY services/ ./services/
COPY config.py .

# Environment for the service
ENV RERANKER_MODEL=BAAI/bge-reranker-v2-m3 \
    RERANKER_DEVICE=cpu \
    RERANKER_BATCH_SIZE=16 \
    RERANKER_PORT=8889 \
    HOST=0.0.0.0 \
    PORT=8889

EXPOSE 8889

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=15s --retries=5 --start-period=60s \
    CMD python3 -c "import httpx; r=httpx.get('http://localhost:8891/health', timeout=10); exit(0 if r.status_code==200 else 1)"

# Run the reranker service directly.
# uvicorn is included via uvicorn[standard] in requirements.txt.
CMD ["python", "-m", "services.bge_reranker"]
